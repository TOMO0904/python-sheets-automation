# Copy to .env (never commit .env) and export the variables in your shell.
# Path to your Google service-account key file. Keep the file OUTSIDE this repository.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
# The id from the spreadsheet URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=your-spreadsheet-id
# Optional worksheet (tab) name; created if missing
WORKSHEET_NAME=Summary
